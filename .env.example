# ─── EcoCommute Environment Variables ───

# MongoDB connection string (MongoDB Atlas or local, optional - in-memory fallback active)
MONGODB_URI="mongodb://localhost:27017/ecocommute"

# JWT secret for authentication
JWT_SECRET="ecocommute-jwt-secret-change-in-production-2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode — enables seeded Indore transport data and deterministic recommendation
NEXT_PUBLIC_DEMO_MODE="true"

# viaSocket Automation Layer (Optional)
VIASOCKET_ENABLED="false"
VIASOCKET_WEBHOOK_URL=""
VIASOCKET_API_KEY=""

# Google Maps API Key (Optional — fallback interactive vector map active)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
